# Скопіюйте цей файл у .env (cp .env.example .env) і підставте свої ключі.
# .env НІКОЛИ не комітиться в git (див. .gitignore).

# Отримати: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Отримати: @BotFather у Telegram -> /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
